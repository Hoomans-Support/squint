{
 "dataset": "synthetic-dining-v1",
 "keep_raw": false,
 "detect": {
  "app": {
   "path": "platform",
   "equals": "app"
  }
 },
 "maps": {
  "app_screens": {
   "MenuBrowse": "prices",
   "Splash": "welcome",
   "SignupPhone": "register_phone",
   "LoginPhone": "login_phone",
   "OtpVerify": "otp",
   "ProfileName": "personal_data",
   "DietPrefs": "tin",
   "PaymentMethod": "kyc_selfie",
   "SignupDone": "register_done",
   "Home": "home",
   "RestaurantPicker": "wallet",
   "PartyDeposit": "topup_amount",
   "BookingConfirm": "topup_confirm",
   "BookingDone": "topup_done",
   "CategoryList": "product_list",
   "CartReview": "txn_details",
   "CheckoutPay": "txn_checkout",
   "OrderPlaced": "txn_done"
  },
  "app_events": {
   "view": "screen_view",
   "leave": "screen_leave",
   "press": "click",
   "input_focus": "form_focus",
   "frantic_press": "rage_click",
   "noop_press": "dead_tap",
   "nav_back": "back",
   "fail": "error",
   "app_closed": "session_end"
  },
  "app_steps": {
   "MenuBrowse": "browse",
   "Splash": "start",
   "SignupPhone": "phone",
   "LoginPhone": "phone",
   "OtpVerify": "otp",
   "ProfileName": "personal_data",
   "DietPrefs": "tin",
   "PaymentMethod": "kyc",
   "SignupDone": "done",
   "Home": "done",
   "RestaurantPicker": "start",
   "PartyDeposit": "amount",
   "BookingConfirm": "confirm",
   "BookingDone": "done",
   "CategoryList": "product",
   "CartReview": "details",
   "CheckoutPay": "checkout",
   "OrderPlaced": "done"
  },
  "device_models": {
   "Redmi 9A": "android_low",
   "Samsung Galaxy A03": "android_low",
   "Infinix Smart 6": "android_low",
   "Realme C11": "android_low",
   "Oppo A15": "android_low",
   "Vivo Y12": "android_low",
   "Samsung Galaxy S23": "android_mid",
   "Pixel 7": "android_mid",
   "Xiaomi 13": "android_mid",
   "Oppo Reno 10": "android_mid",
   "Samsung Galaxy A54": "android_mid",
   "iPhone 11": "ios",
   "iPhone 12": "ios",
   "iPhone 13": "ios",
   "iPhone 14": "ios",
   "iPhone 15": "ios"
  }
 },
 "known_props": {
  "app": {
   "": [
    "_dataset",
    "platform",
    "event_id",
    "session_id",
    "user_id",
    "timestamp",
    "action",
    "page",
    "component",
    "profile",
    "device_info",
    "params"
   ],
   "profile": [
    "tier",
    "build"
   ],
   "device_info": [
    "os",
    "os_version",
    "model",
    "device_id"
   ],
   "params": [
    "dwell_ms",
    "fail_reason",
    "category",
    "total",
    "x",
    "y"
   ]
  }
 },
 "sources": {
  "app": {
   "platform": {
    "const": "app"
   },
   "event_id": "event_id",
   "session_id": "session_id",
   "user_id": "user_id",
   "ts": {
    "path": "timestamp",
    "transform": "iso8601"
   },
   "event_type": {
    "path": "action",
    "map": "app_events"
   },
   "screen": {
    "path": "page",
    "map": "app_screens"
   },
   "step": {
    "path": "page",
    "map": "app_steps"
   },
   "element": "component",
   "persona": "profile.tier",
   "app_version": "profile.build",
   "os": "device_info.os",
   "os_version": "device_info.os_version",
   "device_model": "device_info.model",
   "device_class": {
    "path": "device_info.model",
    "map": "device_models"
   },
   "device_id": "device_info.device_id",
   "product": "params.category",
   "amount_php": "params.total",
   "dwell_ms": "params.dwell_ms",
   "error_code": "params.fail_reason",
   "dataset": "_dataset",
   "tap_x": "params.x",
   "tap_y": "params.y"
  }
 }
}
